# OUTPUT FORMAT:
#
# suite,    benchmark,      language,   prover,         type_encoding,      verification_result,     elapsed_ms,     exit_code
# basic,    Strings.dfy,    tptp,       vampire,        polymorphic,        VERIFIED,                1654,           0
#
#
# VERIFICATION RESULTS:
#
# VERIFIED = program verified without errors 
# NOT_VERIFIED = dafny returned that some path failed to verify
# VERIFICATION_TIMED_OUT = verification timed out
# UNKNOWN = for all other statuses, including resource limit, user error, warnings, inconclusive, solver exceptions etc. Should never 

if [ "$#" -lt 3 ]; then
    echo "Usage: $0 TPTP_PRELUDE TPTP_PLUGIN BENCHMARKS..." >&2
    echo
    echo "Help:"
    echo "TPTP_PRELUDE: the path to the TPTP prelude"
    echo "TPTP_PLUGIN: the path to the TPTP plugin (to be supplied as --solver-plugin to Dafny). Should be under dafny/Binaries."
    echo "BENCHMARKS: one or more directories that contain .dfy files to be included in the benchmark"
    exit 1
fi

TPTP_PRELUDE="$1"
TPTP_PLUGIN="$2"
shift 2

DAFNY_VERIFICATION_TIME_LIMIT="15" # in seconds
REPEAT="1" # how many times to run a single benchmark in each configuration

TYPE_ENCODING_POLYMORPHIC="polymorphic"
TYPE_ENCODING_MONOMORPHIC="monomorphic"
TYPE_ENCODING_PREDICATES="predicates"
TYPE_ENCODING_ARGUMENTS="arguments"

VERIFICATION_RESULT_VERIFIED="VERIFIED"
VERIFICATION_RESULT_NOT_VERIFIED="NOT_VERIFIED"
VERIFICATION_RESULT_VERIFICATION_TIMED_OUT="VERIFICATION_TIMED_OUT"
VERIFICATION_RESULT_VERIFICATION_OUT_OF_RESOURCE="VERIFICATION_OUT_OF_RESOURCE"
VERIFICATION_RESULT_UNKNOWN="UNKNOWN"

LANGUAGE_TPTP="tptp"
LANGUAGE_SMTLIB="smtlib"

PROVER_VAMPIRE="vampire"
PROVER_Z3="z3"

verify_vampire_tptp_polymorphic() 
{
    dafny verify \
        --solver-plugin "$TPTP_PLUGIN" \
        --prelude "$TPTP_PRELUDE" \
        --boogie "/proverOpt:SOLVER=vampire /proverOpt:C:--mode /proverOpt:C:casc" \
        --verification-time-limit "$DAFNY_VERIFICATION_TIME_LIMIT" \
        --allow-warnings \
        "$1"
}

